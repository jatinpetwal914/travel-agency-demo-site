# HINTER ROOTS — Environment Configuration Template
# Duplicate this file to .env.local and populate the values as required.

# Base URL for metadata and canonical links
NEXT_PUBLIC_SITE_URL=https://hinterroots.com

# WhatsApp Business Integration
# Format: Country code followed by mobile number without symbols (e.g., 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Contact & Expedition Operations Email
NEXT_PUBLIC_CONTACT_EMAIL=adventures@hinterroots.com

# Optional Supabase Integration (for persistent cloud inquiry storage and auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only service role key (NEVER expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Email / Notification Service (Resend or SendGrid)
# RESEND_API_KEY=re_123456789
